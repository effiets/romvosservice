rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return get(/databases/$(database)/documents/workspaces/romvos/members/$(request.auth.uid)).data;
    }
    function approved() {
      return request.auth != null && member().active == true
        && member().role in ['owner', 'editor', 'viewer'];
    }
    function writer() {
      return approved() && member().role in ['owner', 'editor'];
    }
    function metaPath() {
      return /databases/$(database)/documents/workspaces/romvos/scheduling/_meta;
    }
    function validStamp(data) {
      return data.revision is int && data.revision > 0
        && data.operationId is string && data.operationId.size() == 36
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }
    // Membership is provisioned by the project owner in the Firebase console.
    // A browser may read its own entry, but cannot grant itself access.
    match /workspaces/romvos/members/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
    match /workspaces/romvos/scheduling/{recordId} {
      allow read: if approved();
      function validMeta() {
        return request.resource.data.keys().hasOnly([
          'revision', 'operationId', 'updatedBy', 'updatedAt', 'schemaVersion'
        ]) && validStamp(request.resource.data) && request.resource.data.schemaVersion == 1;
      }
      function validRecord() {
        let data = request.resource.data;
        let after = getAfter(metaPath()).data;
        return data.keys().hasOnly([
          'kind', 'key', 'payload', 'deleted', 'revision', 'operationId', 'updatedBy', 'updatedAt'
        ]) && validStamp(data)
          && data.kind in ['employees', 'vehicles', 'jobs', 'drafts', 'candidates', 'board']
          && data.key is string && data.key.matches('^[A-Za-z0-9_#:.-]{1,200}$')
          && recordId == data.kind + '__' + data.key
          && data.payload is string && data.payload.size() <= 250000
          && data.deleted is bool && (!data.deleted || data.payload == 'null')
          // Each data change must accompany the same revision transaction.
          && after.revision == data.revision && after.operationId == data.operationId
          && after.updatedAt == request.time && after.updatedBy == request.auth.uid
          && (exists(metaPath())
            ? after.revision == get(metaPath()).data.revision + 1
            : member().role == 'owner' && after.revision == 1);
      }
      allow create: if writer() && (recordId == '_meta'
        ? member().role == 'owner' && validMeta() && request.resource.data.revision == 1
        : validRecord());
      allow update: if writer() && (recordId == '_meta'
        ? validMeta() && request.resource.data.revision == resource.data.revision + 1
        : validRecord() && request.resource.data.kind == resource.data.kind
          && request.resource.data.key == resource.data.key);
      // Deletions are versioned tombstones, so stale clients cannot resurrect
      // an appointment by accidentally saving an older copy of the schedule.
      allow delete: if false;
    }
    // All other modules remain inaccessible through Firestore until migrated.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

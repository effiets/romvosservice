rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return get(/databases/$(database)/documents/workspaces/romvos/members/$(request.auth.uid)).data;
    }
    function approved() {
      return request.auth != null && member().active == true
        && member().role in ['owner', 'editor', 'viewer'];
    }
    function writer() {
      return approved() && member().role in ['owner', 'editor'];
    }
    function owner() {
      return approved() && member().role == 'owner';
    }
    function metaPath() {
      return /databases/$(database)/documents/workspaces/romvos/scheduling/_meta;
    }
    function validStamp(data) {
      return data.revision is int && data.revision > 0
        && data.operationId is string && data.operationId.size() == 36
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }
    // Membership is provisioned by the project owner in the Firebase console.
    // A browser may read its own entry, but cannot grant itself access.
    match /workspaces/romvos/members/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
    match /workspaces/romvos/scheduling/{recordId} {
      allow read: if approved();
      function validMeta() {
        return request.resource.data.keys().hasOnly([
          'revision', 'operationId', 'updatedBy', 'updatedAt', 'schemaVersion'
        ]) && validStamp(request.resource.data) && request.resource.data.schemaVersion == 3;
      }
      function validModule() {
        let data = request.resource.data;
        let after = getAfter(metaPath()).data;
        return request.auth != null && data.keys().hasOnly([
          'kind', 'key', 'payload', 'deleted', 'revision', 'operationId', 'updatedBy', 'updatedAt'
        ]) && validStamp(data)
          && data.kind == 'module'
          && data.key in ['employees', 'vehicles', 'jobs', 'drafts', 'candidates', 'board',
            'clients', 'reminders', 'todos', 'todoArchive', 'orders', 'incoming', 'returns']
          && data.key is string && data.key.matches('^[A-Za-z0-9_#:.-]{1,200}$')
          && recordId == data.kind + '__' + data.key
          && data.payload is string && data.payload.size() <= 900000
          && data.deleted == false
          // Module access is authorized through the _meta write in the same
          // atomic request. This keeps initial import below rules access limits.
          && after.revision == data.revision && after.operationId == data.operationId
          && after.schemaVersion == 3
          && after.updatedAt == request.time && after.updatedBy == request.auth.uid
          && data.updatedBy == request.auth.uid;
      }
      allow create: if recordId == '_meta'
        ? owner() && validMeta() && request.resource.data.revision == 1
        : validModule();
      allow update: if recordId == '_meta'
        ? validMeta() && request.resource.data.revision == resource.data.revision + 1
          && writer()
        : validModule() && request.resource.data.kind == resource.data.kind
          && request.resource.data.key == resource.data.key;
      allow delete: if false;
    }
    // Other HTML applications (inventory, HR, invoices, fleet) remain inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "hosting": {
    "public": "yes",
    "ignore": [
      "firebase.json",
      "**/*BACKUP*.json",
      "**/*Backup*.json",
      "**/*backup*.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
